#!/bin/bash
# Run the balanced scenario in batch mode over a grid of bess capacities and durations.
#
# Usage: bin/run-batch [BATCH]
set -euo pipefail

BATCH="${1:-20261105-vary-bess-capacity}"

for capacity in 1 2 3 4 5 6 7 8; do
  for duration in 4 8 12 16 20; do
    echo "=== bess_capacity_ratio=$capacity bess_duration=$duration ==="
    bin/run --batch "$BATCH" --scenario balanced \
      --config "dispatch.bess_capacity_ratio=$capacity" \
      --config "dispatch.bess_duration=$duration"
  done
done
