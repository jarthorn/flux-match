#!/bin/bash
# Run the balanced scenario in batch mode over a grid of capacity ratios.
# Overrides selection.solar_capacity_ratio and selection.wind_capacity_ratio
# for every integer pair in 0..MAX (default MAX=9 → 100 runs). All runs go in
# output/BATCH/NNNN (default BATCH=vary-capacity-ratio); an existing BATCH folder
# is appended to.
#
# Usage: bin/run-batch [MAX] [BATCH]
set -euo pipefail

MAX="${1:-9}"
BATCH="${2:-vary-capacity-ratio}"

for solar in $(seq 0 "$MAX"); do
  for wind in $(seq 0 "$MAX"); do
    echo "=== solar_capacity_ratio=$solar wind_capacity_ratio=$wind ==="
    bin/run --batch "$BATCH" --scenario balanced \
      --config "selection.solar_capacity_ratio=$solar" \
      --config "selection.wind_capacity_ratio=$wind"
  done
done
