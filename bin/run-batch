#!/bin/bash
# Run each site selection strategy once in batch mode.
#
# Usage: bin/run-batch [BATCH]
set -euo pipefail

BATCH="${1:-20261116-vary-selection-strategy}"

for strategy in balanced cluster tvci wind-tvci; do
  echo "=== scenario=$strategy ==="
  bin/run --batch "$BATCH" --scenario "$strategy"
done
